# Copy to .env for local runs. Never commit real secrets.
# Optional named accounts/gateways; full examples: docs/accounts-and-gateways.md
OMNISEARCH_ACCOUNTS=[]
OMNISEARCH_OMNIROUTE_GATEWAYS=[]

# --- Locale (defaults are CH/DE) ---
OMNISEARCH_COUNTRY=CH
OMNISEARCH_LANGUAGE=de

# --- Orchestration ---
OMNISEARCH_RRF_K=60
OMNISEARCH_SAFETY_BOUND=10000
OMNISEARCH_MAX_PAGES_PER_PROVIDER=250
OMNISEARCH_TIMEOUT_SECONDS=30
OMNISEARCH_CACHE_TTL_SECS=120
OMNISEARCH_COOLDOWN_SECS=60
OMNISEARCH_AUTO_ALLOW_USD=0.05
OMNISEARCH_MAX_PER_DOMAIN=12
OMNISEARCH_INLINE_MAX_BYTES=120000
OMNISEARCH_CACHE_PARTIAL=false
# all | auto | ladder (free-first, then paid by cost)
OMNISEARCH_ROUTE=all
OMNISEARCH_GROUND_TOP=0
OMNISEARCH_EVIDENCE_MIN=8
OMNISEARCH_USER_AGENT=omnisearch/0.1.0 (+https://github.com/RaviTharuma/omnisearch)

# --- HTTP transport ---
OMNISEARCH_HTTP_BIND=127.0.0.1:48731
AUTH_TOKENS=
OMNISEARCH_HTTP_RPM=120

# --- Must-have (default parallel fan-out when set) ---
BRAVE_API_KEY=
# BRAVE_API_KEY_2=
GITHUB_TOKEN=
# GITHUB_API_KEY=
# GITHUB_TOKEN_2=

# --- Web search ---
TAVILY_API_KEY=
# TAVILY_API_KEY_2=
EXA_API_KEY=
# EXA_API_KEY_2=
FIRECRAWL_API_KEY=
LINKUP_API_KEY=
KAGI_API_KEY=
PERPLEXITY_API_KEY=
YOU_API_KEY=
# YDC_API_KEY=
PARALLEL_API_KEY=
QUERIT_API_KEY=
TINYFISH_API_KEY=
KEENABLE_API_KEY=
KEENABLE_PUBLIC=false
KEENABLE_TITLE=omnisearch

# --- X / xAI ---
X_BEARER_TOKEN=
XAI_API_KEY=

# --- Reddit (public search works without these) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- YouTube ---
YOUTUBE_API_KEY=
# GOOGLE_API_KEY=

# --- Instagram / Facebook (official Graph APIs only) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_ACCESS_TOKEN=
# META_ACCESS_TOKEN=

# --- Mastodon ---
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=

# --- Optional Bluesky login (public search works without) ---
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Downstream MCP remotes: name|url|token,... or the token `official` ---
# official expands to (when the matching key is set):
#   tavily|https://mcp.tavily.com/mcp
#   exa|https://mcp.exa.ai/mcp
#   firecrawl|https://mcp.firecrawl.dev/mcp
#   linkup|https://mcp.linkup.so/mcp
#   kagi|https://kagi.com/api/mcp
#   perplexity|https://mcp.perplexity.ai/mcp
OMNISEARCH_MCP_BACKENDS=
